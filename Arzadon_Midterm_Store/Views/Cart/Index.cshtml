@model IEnumerable<Arzadon_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Shopping Cart</h1>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary">
            Continue Shopping
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                @item.ProductName
                            </h5>

                            <p class="card-text">
                                Price:
                                <strong>
                                    ₱@item.Price.ToString("N2")
                                </strong>
                            </p>

                            <form asp-action="UpdateQuantity"
                                  method="post"
                                  class="mb-3">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <label class="form-label">
                                    Quantity
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="1"
                                           class="form-control" />

                                    <button type="submit"
                                            class="btn btn-warning">
                                        Update
                                    </button>

                                </div>

                            </form>

                            <p>
                                Subtotal:
                                <strong>
                                    ₱@((item.Price * item.Quantity).ToString("N2"))
                                </strong>
                            </p>

                            <form asp-action="Remove"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-danger">
                                    Remove
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>

        <div class="card shadow mt-3">

            <div class="card-body text-end">

                <h3>
                    Total:
                    ₱@Model.Sum(item => item.Price * item.Quantity).ToString("N2")
                </h3>

            </div>

        </div>
    }

</div>